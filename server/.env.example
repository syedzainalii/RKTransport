APP_NAME=RK Transport API
DEBUG=false
TIMEZONE=Asia/Dubai
CURRENCY_CODE=AED
# VERCEL is provided automatically by Vercel; do not set it manually.

# Use a long, random value (at least 32 characters) in every deployed environment.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL (Neon / Supabase); replace credentials and host before use.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@POOLER_HOST:5432/rk_transport?sslmode=require

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password-at-least-12-chars
ADMIN_EMAIL=admin@example.com

# Frontend origin(s), comma-separated. Browser calls normally pass through the frontend proxy.
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-FRONTEND.vercel.app

COOKIE_NAME=access_token
# Keep false only for local HTTP development; Vercel production cookies are forced secure.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=replace-with-a-long-random-secret

# Configure one image provider for admin uploads.
BLOB_READ_WRITE_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAX_FILE_SIZE=5242880
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUBLIC_POST=20

# Enable channels in admin settings after setting their credentials.
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
# For Twilio, set WHATSAPP_PROVIDER=twilio and provide all three:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

EMAIL_PROVIDER=smtp
EMAIL_FROM=
# Resend option: set EMAIL_PROVIDER=resend and RESEND_API_KEY.
RESEND_API_KEY=
# SMTP option:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Booking availability defaults (can also be managed in site settings).
# Values are set in the admin booking-availability editor.
