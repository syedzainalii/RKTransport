APP_NAME=RK Transport API
DEBUG=false
TIMEZONE=Asia/Dubai
CURRENCY_CODE=AED
# VERCEL is provided automatically by Vercel; do not set it manually.

# Replace all placeholders with deployment-specific values. Never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Use the pooled PostgreSQL connection string (Neon/Supabase) with SSL enabled.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/DATABASE?sslmode=require

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password-at-least-12-chars
ADMIN_EMAIL=admin@example.com

# Exact frontend origins, comma-separated; do not use a wildcard.
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-FRONTEND-DOMAIN

COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Configure one image provider for admin uploads.
BLOB_READ_WRITE_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAX_FILE_SIZE=5242880
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUBLIC_POST=20

WHATSAPP_PROVIDER=cloud_api
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
# For Twilio, set WHATSAPP_PROVIDER=twilio and provide all three:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

EMAIL_PROVIDER=smtp
EMAIL_FROM=
# Resend option: set EMAIL_PROVIDER=resend and RESEND_API_KEY.
RESEND_API_KEY=
# SMTP option:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
