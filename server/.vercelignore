# ---------- Local uploads (only at the repo root or server root, not code folders) ----------
/uploads/
/server/uploads/

# ---------- Local-only scripts ----------
start.bat
start.sh
/server/migrate_*.py

# ---------- Docs and example files (not needed at runtime) ----------
README.md
DEPLOYMENT.md
.env.example
.env.production.example

# ---------- Editor and OS files ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------- Build output (Vercel recreates these) ----------
node_modules/
.next/
